{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pier",
  "mainBinaryName": "Pier",
  "version": "0.1.2",
  "identifier": "com.sshgui.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pier",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1280,
        "minWidth": 800,
        "minHeight": 500,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5OTU3NUQyMTkyOUEwODUKUldTRm9Da1owbldWS2Y2a29HWHVhWDdJT29Jbll4WGtZWGJCRTlyamYwWk9ZUnlwWDNyMFFHWFIK",
      "endpoints": [
        "https://github.com/Banana-Master/pier/releases/latest/download/latest.json"
      ]
    }
  }
}